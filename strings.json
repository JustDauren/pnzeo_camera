{
  "config": {
    "step": {
      "user": {
        "title": "PNZEO Camera",
        "description": "Add a PNZEO camera to Home Assistant",
        "data": {
          "method": "Setup method"
        }
      },
      "manual": {
        "title": "Camera IP",
        "data": {
          "host": "IP Address"
        }
      },
      "pick": {
        "title": "Select Camera",
        "data": {
          "ip": "Camera"
        }
      },
      "credentials": {
        "title": "Camera Password",
        "description": "Enter the camera password (factory default: 8888). We strongly recommend changing it after setup.",
        "data": {
          "password": "Password",
          "device_id": "Device ID",
          "rtsp_port": "RTSP port"
        }
      }
    },
    "abort": {
      "no_devices_found": "No PNZEO cameras found on the network",
      "already_configured": "This camera is already configured"
    },
    "error": {
      "cannot_connect": "Cannot connect to camera. Check IP and port.",
      "invalid_auth": "Wrong password. Check credentials.",
      "password_change_failed": "Failed to change password on camera."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Camera Settings",
        "data": {
          "change_password": "Change camera password",
          "new_password": "New password"
        }
      }
    }
  },
  "services": {
    "ptz_control": {
      "name": "PTZ Control",
      "description": "Control camera pan/tilt/zoom",
      "fields": {
        "direction": {
          "name": "Direction",
          "description": "Movement direction (up, down, left, right, center, zoom_in, zoom_out, patrol_lr, patrol_ud)"
        },
        "step": {
          "name": "Step mode",
          "description": "0 = continuous, 1 = one step"
        }
      }
    },
    "goto_preset": {
      "name": "Go to Preset",
      "description": "Move camera to a saved preset position",
      "fields": {
        "preset": {
          "name": "Preset number",
          "description": "Preset position (0-15)"
        }
      }
    },
    "set_preset": {
      "name": "Save Preset",
      "description": "Save current camera position as preset",
      "fields": {
        "preset": {
          "name": "Preset number",
          "description": "Preset slot to save to (0-15)"
        }
      }
    },
    "send_command": {
      "name": "Send Raw Command",
      "description": "Send raw PPPP command to camera (advanced)",
      "fields": {
        "msg_type": {
          "name": "Message type",
          "description": "PPPP message type ID"
        }
      }
    },
    "change_password": {
      "name": "Change Camera Password",
      "description": "Change the camera login password via PPPP",
      "fields": {
        "new_password": {
          "name": "New password",
          "description": "New password for the camera (will be saved in integration config)"
        }
      }
    },
    "get_alarm_log": {
      "name": "Get Alarm Log",
      "description": "Retrieve alarm log entries from camera"
    },
    "sync_time": {
      "name": "Sync Time",
      "description": "Synchronize camera time with Home Assistant system time"
    },
    "start_recording": {
      "name": "Start Recording",
      "description": "Trigger manual recording on camera SD card"
    },
    "wifi_scan": {
      "name": "WiFi Scan",
      "description": "Scan for available WiFi networks from camera"
    },
    "wifi_connect": {
      "name": "WiFi Connect",
      "description": "Connect camera to a WiFi network",
      "fields": {
        "ssid": {
          "name": "SSID",
          "description": "WiFi network name"
        },
        "password": {
          "name": "Password",
          "description": "WiFi password"
        },
        "security": {
          "name": "Security",
          "description": "Security type: 0=None, 1=WEP, 2=WPA, 3=WPA2"
        }
      }
    },
    "set_ddns": {
      "name": "Set DDNS",
      "description": "Configure dynamic DNS settings",
      "fields": {
        "service": {
          "name": "DDNS Service",
          "description": "DDNS provider name"
        },
        "hostname": {
          "name": "Hostname",
          "description": "DDNS hostname"
        },
        "user": {
          "name": "Username",
          "description": "DDNS account username"
        },
        "password": {
          "name": "Password",
          "description": "DDNS account password"
        },
        "port": {
          "name": "Port",
          "description": "DDNS port"
        }
      }
    },
    "get_users": {
      "name": "Get Users",
      "description": "List camera user accounts (3 slots)"
    },
    "manage_users": {
      "name": "Manage Users",
      "description": "Set camera user accounts (all 3 slots, empty = remove)",
      "fields": {
        "user1": {
          "name": "User 1 Name",
          "description": "Primary user (admin)"
        },
        "pwd1": {
          "name": "User 1 Password",
          "description": "Primary user password"
        },
        "user2": {
          "name": "User 2 Name",
          "description": "Secondary user"
        },
        "pwd2": {
          "name": "User 2 Password",
          "description": "Secondary user password"
        },
        "user3": {
          "name": "User 3 Name",
          "description": "Third user"
        },
        "pwd3": {
          "name": "User 3 Password",
          "description": "Third user password"
        }
      }
    },
    "set_ftp": {
      "name": "Configure FTP Upload",
      "description": "Set FTP server for alarm snapshot/recording uploads",
      "fields": {
        "server": {
          "name": "FTP Server",
          "description": "FTP server hostname or IP"
        },
        "port": {
          "name": "Port",
          "description": "FTP port"
        },
        "user": {
          "name": "Username",
          "description": "FTP username"
        },
        "password": {
          "name": "Password",
          "description": "FTP password"
        },
        "directory": {
          "name": "Directory",
          "description": "Upload directory path"
        },
        "mode": {
          "name": "Transfer Mode",
          "description": "0 = Active (PORT), 1 = Passive (PASV)"
        },
        "upload_interval": {
          "name": "Upload Interval",
          "description": "Seconds between uploads (0 = every alarm)"
        }
      }
    },
    "set_email": {
      "name": "Configure Email Notifications",
      "description": "Set SMTP server for alarm email notifications",
      "fields": {
        "smtp_server": {
          "name": "SMTP Server",
          "description": "SMTP server hostname"
        },
        "smtp_port": {
          "name": "SMTP Port",
          "description": "SMTP port (587 for TLS)"
        },
        "user": {
          "name": "Username",
          "description": "SMTP username"
        },
        "password": {
          "name": "Password",
          "description": "SMTP password"
        },
        "sender": {
          "name": "Sender Email",
          "description": "From email address"
        },
        "receiver": {
          "name": "Receiver Email",
          "description": "Recipient email address"
        },
        "ssl": {
          "name": "SSL/TLS",
          "description": "0 = off, 1 = TLS/STARTTLS"
        }
      }
    },
    "set_push_token": {
      "name": "Set Push Token",
      "description": "Register FCM push notification token for alarm alerts",
      "fields": {
        "token": {
          "name": "FCM Token",
          "description": "Firebase Cloud Messaging token"
        }
      }
    },
    "get_ftp_settings": {
      "name": "Get FTP Settings",
      "description": "Retrieve current FTP upload configuration from camera (fires pnzeo_camera_ftp_settings event)"
    },
    "get_email_settings": {
      "name": "Get Email Settings",
      "description": "Retrieve current email notification configuration from camera (fires pnzeo_camera_email_settings event)"
    },
    "listen_audio": {
      "name": "Listen Audio",
      "description": "Start listening to camera audio stream (DRW channel 2, G.711 A-law)"
    },
    "stop_audio": {
      "name": "Stop Audio",
      "description": "Stop listening to camera audio stream"
    },
    "talk": {
      "name": "Talk",
      "description": "Send audio data to camera speaker (DRW channel 3). Provide base64-encoded 16-bit signed LE PCM at 8000Hz mono.",
      "fields": {
        "audio_data": {
          "name": "Audio Data",
          "description": "Base64-encoded 16-bit signed little-endian PCM audio at 8000Hz mono"
        }
      }
    },
    "set_recording_schedule": {
      "name": "Set Recording Schedule",
      "description": "Configure SD card recording schedule (25 params for weekly schedule)",
      "fields": {
        "rec_sch_enable": {
          "name": "Schedule Enable",
          "description": "Enable scheduled recording (0=off, 1=on)"
        },
        "rec_sch_sun_0": {
          "name": "Sunday Block 1",
          "description": "Sunday recording block 1 bitmask"
        },
        "rec_sch_sun_1": {
          "name": "Sunday Block 2",
          "description": "Sunday recording block 2 bitmask"
        },
        "rec_sch_sun_2": {
          "name": "Sunday Block 3",
          "description": "Sunday recording block 3 bitmask"
        },
        "rec_sch_mon_0": {
          "name": "Monday Block 1",
          "description": "Monday recording block 1 bitmask"
        },
        "rec_sch_mon_1": {
          "name": "Monday Block 2",
          "description": "Monday recording block 2 bitmask"
        },
        "rec_sch_mon_2": {
          "name": "Monday Block 3",
          "description": "Monday recording block 3 bitmask"
        },
        "rec_sch_tue_0": {
          "name": "Tuesday Block 1",
          "description": "Tuesday recording block 1 bitmask"
        },
        "rec_sch_tue_1": {
          "name": "Tuesday Block 2",
          "description": "Tuesday recording block 2 bitmask"
        },
        "rec_sch_tue_2": {
          "name": "Tuesday Block 3",
          "description": "Tuesday recording block 3 bitmask"
        },
        "rec_sch_wed_0": {
          "name": "Wednesday Block 1",
          "description": "Wednesday recording block 1 bitmask"
        },
        "rec_sch_wed_1": {
          "name": "Wednesday Block 2",
          "description": "Wednesday recording block 2 bitmask"
        },
        "rec_sch_wed_2": {
          "name": "Wednesday Block 3",
          "description": "Wednesday recording block 3 bitmask"
        },
        "rec_sch_thu_0": {
          "name": "Thursday Block 1",
          "description": "Thursday recording block 1 bitmask"
        },
        "rec_sch_thu_1": {
          "name": "Thursday Block 2",
          "description": "Thursday recording block 2 bitmask"
        },
        "rec_sch_thu_2": {
          "name": "Thursday Block 3",
          "description": "Thursday recording block 3 bitmask"
        },
        "rec_sch_fri_0": {
          "name": "Friday Block 1",
          "description": "Friday recording block 1 bitmask"
        },
        "rec_sch_fri_1": {
          "name": "Friday Block 2",
          "description": "Friday recording block 2 bitmask"
        },
        "rec_sch_fri_2": {
          "name": "Friday Block 3",
          "description": "Friday recording block 3 bitmask"
        },
        "rec_sch_sat_0": {
          "name": "Saturday Block 1",
          "description": "Saturday recording block 1 bitmask"
        },
        "rec_sch_sat_1": {
          "name": "Saturday Block 2",
          "description": "Saturday recording block 2 bitmask"
        },
        "rec_sch_sat_2": {
          "name": "Saturday Block 3",
          "description": "Saturday recording block 3 bitmask"
        },
        "rec_sch_record_time": {
          "name": "Record Time",
          "description": "Recording segment length in seconds"
        },
        "rec_sch_mode": {
          "name": "Schedule Mode",
          "description": "0=continuous during schedule, 1=motion-triggered during schedule"
        },
        "rec_sch_prerecord": {
          "name": "Pre-record",
          "description": "Enable pre-recording on alarm trigger (0=off, 1=on)"
        }
      }
    }
  }
}
